-indep-pairwise  ${window} ${shift} ${r2} \\\n        --rm-dup force-first \\\n        --out ${_output[\"prune\"]:annr} \\\n        --threads ${numThreads}\n","key":"fKK5GamOx5"},{"type":"outputs","id":"kC1GtBEeNSZUIZBS5CxpG","children":[],"key":"cIW1RMZ8mH"}],"identifier":"1472106b","html_id":"1472106b","key":"pZu9QCCJcG"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[LD_pruning_2]\ninput: group_by = \"all\"\noutput: f'{cwd}/{step_name[:-2]}/LD_pruned_variants.txt'\nbash: expand= \"${ }\", stderr = f'{_output:n}.stderr', stdout = f'{_output:n}.stdout'\n    Rscript ${modular_script_dir}/reference_data/ld_prune_reference.R \\\n        --input ${_input:r,} \\\n        --output ${_output:r}\n","key":"LiiGvaz5os"},{"type":"outputs","id":"5UnO1wXagTET2WLqhuQrM","children":[],"key":"I5uslSTAQv"}],"identifier":"69592b8a","html_id":"69592b8a","key":"O7nuRSsAUB"}],"key":"Lt9Yi69g4H"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Generation of Topologically Associated Domains and their Boundaries","url":"/generalized-tadb","group":"Reference data"},"next":{"title":"RSS LD Sketch Pipeline","url":"/rss-ld-sketch","group":"Reference data"}}},"domain":"http://pre.render"}