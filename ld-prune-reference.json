"prune\"]:annr} \\\n        --threads ${numThreads}\n","key":"H3l9sFoOi5"},{"type":"outputs","id":"bp53SNj29IMgFrdlEJ2Eo","children":[],"key":"EAR1BoAWRP"}],"identifier":"1472106b","html_id":"1472106b","key":"EFk8pIVklE"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[LD_pruning_2]\ninput: group_by = \"all\"\noutput: f'{cwd}/{step_name[:-2]}/LD_pruned_variants.txt'\nbash: expand= \"${ }\", stderr = f'{_output:n}.stderr', stdout = f'{_output:n}.stdout'\n    Rscript ${modular_script_dir}/reference_data/ld_prune_reference.R \\\n        --input ${_input:r,} \\\n        --output ${_output:r}\n","key":"KlHG2M41yg"},{"type":"outputs","id":"lKYcFFDuBC50L697Ccfp8","children":[],"key":"bBClKVDmt4"}],"identifier":"69592b8a","html_id":"69592b8a","key":"E3Mk7prE8t"}],"key":"KmmZUmGnty"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Generation of Topologically Associated Domains and their Boundaries","url":"/generalized-tadb","group":"Reference data"},"next":{"title":"RSS LD Sketch Pipeline","url":"/rss-ld-sketch","group":"Reference data"}}},"domain":"http://localhost:3000"}