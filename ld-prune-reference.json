ock","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[global]\nparameter: cwd = path(\"output\")\n# Directory holding the modular analysis scripts (code/script)\nparameter: modular_script_dir = path('code/script')\nparameter: job_size = 1\nparameter: walltime = \"1h\"\nparameter: mem = \"80G\"\nparameter: numThreads = 10\n","key":"vynov426tJ"},{"type":"outputs","id":"xVuUjknlWM8uIhRNTswlp","children":[],"key":"UInb34U5bs"}],"identifier":"9919cee8","html_id":"9919cee8","key":"jn2eQYRuc6"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[LD_pruning_1]\nparameter: genotype_list = path\nparameter: window = 50\nparameter: shift = 10\nparameter: r2 = 1e-3\n\nimport csv\n# genotype_list: header row + one row per block (block_id, bfile...); pandas read\n# used header=0, so the first row is treated as a header here too.\nwith open(genotype_list) as _fh:\n    _rows = [r for r in csv.reader(_fh, delimiter=\"\\t\") if r]\n_rows = _rows[1:]\ninput_blocks = [r[0] for r in _rows]\ninput_files = [r[1:] for r in _rows]\ndel _rows, _fh\n\ninput: input_files, group_by = 1, group_with = \"input_blocks\"\noutput: prune = f'{cwd}/{step_name[:-2]}/{_input_blocks}.prune.in'\ntask: trunk_workers = 1, trunk_size = job_size, walltime = walltime, mem = mem, cores = numThreads, tags = f'{step_name}_{_output:bn}'\nbash: expand= \"${ }\", stderr = f'{_output:n}.stderr', stdout = f'{_output:n}.stdout'\n    plink2 \\\n        --bfile  ${_input:anr} \\\n        --indep-pairwise  ${window} ${shift} ${r2} \\\n        --rm-dup force-first \\\n        --out ${_output[\"prune\"]:annr} \\\n        --threads ${numThreads}\n","key":"QdbDFbFSSS"},{"type":"outputs","id":"6L-wFfRzNFicnr100oWCu","children":[],"key":"H4LqrUScFW"}],"identifier":"1472106b","html_id":"1472106b","key":"n4wx5aPj5O"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[LD_pruning_2]\ninput: group_by = \"all\"\noutput: f'{cwd}/{step_name[:-2]}/LD_pruned_variants.txt'\nbash: expand= \"${ }\", stderr = f'{_output:n}.stderr', stdout = f'{_output:n}.stdout'\n    Rscript ${modular_script_dir}/reference_data/ld_prune_reference.R \\\n        --input ${_input:r,} \\\n        --output ${_output:r}\n","key":"jmO6fDQgP2"},{"type":"outputs","id":"_9UJ1c-q0YlDrL4PevQ1t","children":[],"key":"FgvOYzkg1m"}],"identifier":"69592b8a","html_id":"69592b8a","key":"qqP5LSrz2V"}],"key":"LOHiQveuVM"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Generation of Topologically Associated Domains and their Boundaries","url":"/generalized-tadb","group":"Reference data"},"next":{"title":"RSS LD Sketch Pipeline","url":"/rss-ld-sketch","group":"Reference data"}}},"domain":"http://pre.render"}