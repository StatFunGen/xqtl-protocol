e\"]:annr} \\\n        --threads ${numThreads}\n","key":"ibgc2Fa5Iq"},{"type":"outputs","id":"gnEKi31ZEFl3-svxB0wsM","children":[],"key":"sV71wp8rdy"}],"identifier":"1472106b","html_id":"1472106b","key":"gbX4mndo5W"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[LD_pruning_2]\ninput: group_by = \"all\"\noutput: f'{cwd}/{step_name[:-2]}/LD_pruned_variants.txt'\nbash: expand= \"${ }\", stderr = f'{_output:n}.stderr', stdout = f'{_output:n}.stdout'\n    Rscript ${modular_script_dir}/reference_data/ld_prune_reference.R \\\n        --input ${_input:r,} \\\n        --output ${_output:r}\n","key":"YC3SluUBtm"},{"type":"outputs","id":"Q2FuTI2pfwG8nmZDmdq2M","children":[],"key":"fj5u3seb5X"}],"identifier":"69592b8a","html_id":"69592b8a","key":"JyoujPUFUE"}],"key":"h7uOaAV524"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Generation of Topologically Associated Domains and their Boundaries","url":"/generalized-tadb","group":"Reference data"},"next":{"title":"RSS LD Sketch Pipeline","url":"/rss-ld-sketch","group":"Reference data"}}},"domain":"http://pre.render"}