numThreads}\n","key":"GbrI7RvUlL"},{"type":"outputs","id":"H7--d0LhXobGESOIdfXtl","children":[],"key":"y8AEA2NZzs"}],"identifier":"1472106b","html_id":"1472106b","key":"DTiSRV8jMQ"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[LD_pruning_2]\ninput: group_by = \"all\"\noutput: f'{cwd}/{step_name[:-2]}/LD_pruned_variants.txt'\nbash: expand= \"${ }\", stderr = f'{_output:n}.stderr', stdout = f'{_output:n}.stdout'\n    Rscript ${modular_script_dir}/reference_data/ld_prune_reference.R \\\n        --input ${_input:r,} \\\n        --output ${_output:r}\n","key":"Cw5WCSvN5M"},{"type":"outputs","id":"_83mhssQp2-xl1TdGLYuk","children":[],"key":"ce8r5Fgeof"}],"identifier":"69592b8a","html_id":"69592b8a","key":"mFJcrlYMou"}],"key":"nr5vMfhxwo"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Generation of Topologically Associated Domains and their Boundaries","url":"/generalized-tadb","group":"Reference data"},"next":{"title":"RSS LD Sketch Pipeline","url":"/rss-ld-sketch","group":"Reference data"}}},"domain":"http://pre.render"}