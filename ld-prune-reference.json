[\"prune\"]:annr} \\\n        --threads ${numThreads}\n","key":"bDBfkkhrcM"},{"type":"outputs","id":"JD2DMbs8gwtLSE3oz_sqc","children":[],"key":"Yx3vnEBnpI"}],"identifier":"1472106b","html_id":"1472106b","key":"CRWb48z1Xb"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[LD_pruning_2]\ninput: group_by = \"all\"\noutput: f'{cwd}/{step_name[:-2]}/LD_pruned_variants.txt'\nbash: expand= \"${ }\", stderr = f'{_output:n}.stderr', stdout = f'{_output:n}.stdout'\n    Rscript ${modular_script_dir}/reference_data/ld_prune_reference.R \\\n        --input ${_input:r,} \\\n        --output ${_output:r}\n","key":"Ui3eReIz3q"},{"type":"outputs","id":"vAxrl6h0ubZxPmJX0ec01","children":[],"key":"BCtdqhzb3v"}],"identifier":"69592b8a","html_id":"69592b8a","key":"phOWJMAM7c"}],"key":"BQ6wVcfsZj"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Generation of Topologically Associated Domains and their Boundaries","url":"/generalized-tadb","group":"Reference data"},"next":{"title":"RSS LD Sketch Pipeline","url":"/rss-ld-sketch","group":"Reference data"}}},"domain":"http://pre.render"}