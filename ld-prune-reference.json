"prune\"]:annr} \\\n        --threads ${numThreads}\n","key":"R0llF6eOia"},{"type":"outputs","id":"VeE9hUC7DHmCWHvK9tuJ-","children":[],"key":"yVRZLkm3Ti"}],"identifier":"1472106b","html_id":"1472106b","key":"Je4hAmV13g"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[LD_pruning_2]\ninput: group_by = \"all\"\noutput: f'{cwd}/{step_name[:-2]}/LD_pruned_variants.txt'\nbash: expand= \"${ }\", stderr = f'{_output:n}.stderr', stdout = f'{_output:n}.stdout'\n    Rscript ${modular_script_dir}/reference_data/ld_prune_reference.R \\\n        --input ${_input:r,} \\\n        --output ${_output:r}\n","key":"JC1ZKYlpOO"},{"type":"outputs","id":"03mj7Ejbw8A9pjM7UBHmw","children":[],"key":"C23gbcD1I3"}],"identifier":"69592b8a","html_id":"69592b8a","key":"RNzqRIG54l"}],"key":"mA7z8Tkq8F"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Generation of Topologically Associated Domains and their Boundaries","url":"/generalized-tadb","group":"Reference data"},"next":{"title":"RSS LD Sketch Pipeline","url":"/rss-ld-sketch","group":"Reference data"}}},"domain":"http://localhost:3000"}