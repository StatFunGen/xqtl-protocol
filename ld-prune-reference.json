-indep-pairwise  ${window} ${shift} ${r2} \\\n        --rm-dup force-first \\\n        --out ${_output[\"prune\"]:annr} \\\n        --threads ${numThreads}\n","key":"ouIO3aUrKH"},{"type":"outputs","id":"z01n4czCsBOfDdrd7K1SK","children":[],"key":"e7JlftEZMq"}],"identifier":"1472106b","html_id":"1472106b","key":"uH5xFMvWET"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[LD_pruning_2]\ninput: group_by = \"all\"\noutput: f'{cwd}/{step_name[:-2]}/LD_pruned_variants.txt'\nbash: expand= \"${ }\", stderr = f'{_output:n}.stderr', stdout = f'{_output:n}.stdout'\n    Rscript ${modular_script_dir}/reference_data/ld_prune_reference.R \\\n        --input ${_input:r,} \\\n        --output ${_output:r}\n","key":"enH1su54f6"},{"type":"outputs","id":"iAIx-l2mUkRfXXBvvfxtL","children":[],"key":"IT0q7oTDIR"}],"identifier":"69592b8a","html_id":"69592b8a","key":"d3qpMS5g2k"}],"key":"EGHcccmM4m"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Generation of Topologically Associated Domains and their Boundaries","url":"/generalized-tadb","group":"Reference data"},"next":{"title":"RSS LD Sketch Pipeline","url":"/rss-ld-sketch","group":"Reference data"}}},"domain":"http://pre.render"}