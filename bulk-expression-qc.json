sos run pipeline/bulk_expression_QC.ipynb\n               [workflow_name | -t targets] [options] [workflow_options]\n  workflow_name:        Single or combined workflows defined in this script\n  targets:              One or more targets to generate\n  options:              Single-hyphen sos parameters (see \"sos run -h\" for details)\n  workflow_options:     Double-hyphen workflow-specific parameters\n\nWorkflows:\n  qc\n\nGlobal Workflow Options:\n  --modular-script-dir code/script (as path)\n  --tpm-gct VAL (as path, required)\n                        Required input is TPM file\n  --counts-gct . (as path)\n                        Raw counts file is optional and if available, it will be\n                        filtered to match with the TPM file sample and genes\n  --cwd output (as path)\n  --container ''\n  --entrypoint  ('micromamba run -a \"\" -n' + ' ' + re.sub(r'(_apptainer:latest|_docker:latest|\\.sif)$', '', container.split('/')[-1])) if container else \"\"\n\n  --job-size 1 (as int)\n                        For cluster jobs, number commands to run per job\n  --walltime 5h\n                        Wall clock time expected\n  --mem 16G\n                        Memory expected\n  --numThreads 8 (as int)\n                        Number of threads\n\nSections\n  qc_1:\n    Workflow Options:\n      --low-expr-TPM 0.1 (as float)\n      --low-expr-TPM-percent 0.2 (as float)\n  qc_2:\n    Workflow Options:\n      --RLEFilterPercent 0.05 (as float)\n      --DSFilterPercent 0.05 (as float)\n      --topk-genes 100 (as int)\n      --cluster-percent 0.6 (as float)\n      --pvalue-cutoff 0.05 (as float)\n      --cluster-level 5 (as int)\n  qc_3:","position":{"start":{"line":1,"column":1},"end":{"line":46,"column":1}},"key":"hKwNur0HAJ"}],"identifier":"b1f36707","html_id":"b1f36707","key":"WLjBLf8YeW"},{"type":"block","kind":"notebook-content","data":{"kernel":"SoS"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Workflow implementation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZZcaerm5hV"}],"identifier":"workflow-implementation","label":"Workflow implementation","html_id":"workflow-implementation","implicit":true,"key":"K8RWxutSX4"}],"identifier":"14408e99","html_id":"14408e99","key":"CVEt2lKE7y"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[global]\nparameter: modular_script_dir = path('code/script')  # override with --modular-script-dir\n# Required input is TPM file\nparameter: tpm_gct = path\n# Raw counts file is optional and if available, it will be filtered to match with the TPM file sample and genes\nparameter: counts_gct = path()\nparameter: cwd = path(\"output\")\nparameter: container = \"\"\nimport re\nparameter: entrypoint= ('micromamba run -a \"\" -n' + ' ' + re.sub(r'(_apptainer:latest|_docker:latest|\\.sif)$', '', container.split('/')[-1])) if container else \"\"\ncwd = path(f'{cwd:a}')\n# For cluster jobs, number commands to run per job\nparameter: job_size = 1\n# Wall clock time expected\nparameter: walltime = \"5h\"\n# Memory expected\nparameter: mem = \"16G\"\n\n# Number of threads\nparameter: numThreads = 8","key":"NmPoQbiZCN"},{"type":"outputs","id":"2kRZOLRBzquzmUFRDwlDA","children":[],"key":"IcznCVLn3b"}],"identifier":"d1b6c7da","html_id":"d1b6c7da","key":"rHOQR77xvv"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[qc_1 (basic check and low expression filtering)]\nparameter: low_expr_TPM = 0.1\nparameter: low_expr_TPM_percent = 0.2\ninput: tpm_gct\noutput: f'{cwd}/{_input:bnnn}.low_expression_filtered.tpm.gct.gz'\ntask: trunk_workers = 1, trunk_size = job_size, walltime = walltime, mem = mem, cores = numThreads\nbash: expand= \"${ }\", stderr = f'{_output:nnn}.stderr', stdout = f'{_output:nnn}.log', container = container, entrypoint = entrypoint\n    Rscript ${modular_script_dir}/molecular_phenotypes/QC/bulk_expression_QC.R \\\n        --step qc_1 \\\n        --cwd \"${cwd}\" \\\n        --tpm-gct \"${_input}\" \\\n        --low-expr-TPM ${low_expr_TPM} \\\n        --low-expr-TPM-percent ${low_expr_TPM_percent} \\\n        --numThreads ${numThreads}\n","key":"YyUbXxQvGu"},{"type":"outputs","id":"fbYHpvaTJHQ-LPAAEvTal","children":[],"key":"InIsU6bJe8"}],"identifier":"4c031846","html_id":"4c031846","key":"A48QM6Th6p"},{"type":"block","kind":"notebook-content","data":{"kernel":"SoS"},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Caution.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XUgAjnf03f"}],"key":"pKbbA9CMQk"},{"type":"text","value":" The offset used for the log transformation on TPM is unresolved. GTEx suggests an offset of 1; the recommendation kept here follows ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yduQQNf8vA"},{"type":"link","url":"https://github.com/stormlovetao/eQTLQC/blob/master/Sample/src/report.Rmd","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"these authors","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oiWnpQZZtM"}],"urlSource":"https://github.com/stormlovetao/eQTLQC/blob/master/Sample/src/report.Rmd","data":{"kind":"file","org":"stormlovetao","repo":"eQTLQC","reference":"master","file":"Sample/src/report.Rmd","raw":"https://raw.githubusercontent.com/stormlovetao/eQTLQC/master/Sample/src/report.Rmd"},"internal":false,"protocol":"github","key":"dmbIze0tok"},{"type":"text","value":", where both 0.0001 and 1 are used at different steps.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1