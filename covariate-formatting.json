ition":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Vk04onGifz"}],"identifier":"command-interface","label":"Command Interface","html_id":"command-interface","implicit":true,"key":"upsxzweHaA"}],"identifier":"af3c9395","html_id":"af3c9395","key":"Mj57EArXCF"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"sos run pipeline/covariate_formatting.ipynb -h","key":"DpAuXWngnb"},{"type":"outputs","id":"FoQE_JsIc8jD32RkQEen7","children":[],"key":"qbmniyn4M0"}],"identifier":"e7faa9c3","html_id":"e7faa9c3","key":"DV2sWAhuiv"},{"type":"block","kind":"notebook-content","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"","value":"usage: sos run pipeline/covariate_formatting.ipynb\n               [workflow_name | -t targets] [options] [workflow_options]\n  workflow_name:        Single or combined workflows defined in this script\n  targets:              One or more targets to generate\n  options:              Single-hyphen sos parameters (see \"sos run -h\" for details)\n  workflow_options:     Double-hyphen workflow-specific parameters\n\nWorkflows:\n  merge_genotype_pc\n\nGlobal Workflow Options:\n  --modular-script-dir code/script (as path)\n  --cwd output (as path)\n                        The output directory for generated files.\n  --covFile VAL (as path, required)\n                        The covariate file\n  --job-size 1 (as int)\n                        For cluster jobs, number commands to run per job\n  --walltime 5h\n                        Wall clock time expected\n  --mem 2G\n                        Memory expected\n  --numThreads 8 (as int)\n                        Number of threads\n  --container ''\n                        Software container option\n  --entrypoint ''\n\nSections\n  merge_genotype_pc:\n    Workflow Options:\n      --pcaFile VAL (as path, required)\n                        An RDS file as the output of the genotype PCA module\n      --k 20 (as int)\n                        The number of PCs to retain, by default is 20, in\n                        practice can be the number of PC that captured more than\n                        70% PVE\n      --name  f'{covFile:bn}.{pcaFile:bn}'\n\n      --outliersFile . (as path)\n                        Outliers\n      --[no-]remove-outliers (default to False)\n      --tol-cov -1.0 (as float)\n                        Tolerance of missingness in covariates, -1 means do\n                        nothing, otherwise for samples with covariates missing\n                        rate larger than tol_cov will be removed, with missing\n                        rate smaller than tol_cov will be kept.\n      --[no-]mean-impute (default to True)","position":{"start":{"line":1,"column":1},"end":{"line":50,"column":1}},"key":"SZ7Sb2HvBV"}],"identifier":"f8dd7601","html_id":"f8dd7601","key":"gTQmAm4M7l"},{"type":"block","kind":"notebook-content","data":{"kernel":"SoS"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Workflow implementation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CXDV0HLnsY"}],"identifier":"workflow-implementation","label":"Workflow implementation","html_id":"workflow-implementation","implicit":true,"key":"ZSTKoexl4d"}],"identifier":"a8a06a15","html_id":"a8a06a15","key":"XoHILRntIE"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[global]\nparameter: modular_script_dir = path('code/script')  # override with --modular-script-dir\n# The output directory for generated files. \nparameter: cwd = path(\"output\")\n# The covariate file\nparameter: covFile = path\n# For cluster jobs, number commands to run per job\nparameter: job_size = 1\n# Wall clock time expected\nparameter: walltime = \"5h\"\n# Memory expected\nparameter: mem = \"2G\"\n# Number of threads\nparameter: numThreads = 8\n# Software container option\nparameter: container = \"\"\nparameter: entrypoint=\"\"\ncwd = path(f\"{cwd:a}\")","key":"mbftRNPpTZ"},{"type":"outputs","id":"GapWbzFf0sJFEeWxmQt0u","children":[],"key":"kJHBhK24Gn"}],"identifier":"44aae970","html_id":"44aae970","key":"v6QTfbsY7s"},{"type":"block","kind":"notebook-code","data":{"kernel":"SoS"},"children":[{"type":"code","lang":"sos","executable":true,"value":"[merge_genotype_pc]\n# An RDS file as the output of the genotype PCA module\nparameter: pcaFile = path\n# The number of PCs to retain, by default is 20, in practice can be the number of PC that captured more than 70% PVE\nparameter: k = 20\nparameter: name = f'{covFile:bn}.{pcaFile:bn}'\n# Outliers\nparameter: outliersFile = path(\".\") \nparameter: remove_outliers = False\n# Tolerance of missingness in covariates, -1 means do nothing, otherwise for samples with covariates missing rate larger than tol_cov will be removed,\n# with missing rate smaller than tol_cov will be kept.\nparameter: tol_cov = -1.0 \nparameter: mean_impute = True\nstop_if(remove_outliers and not outliersFile.is_file(), msg = \"No outliers file specified, please add outliers file or remove the remove-outliers flag\")\ninput: pcaFile, covFile\noutput:  f'{cwd:a}/{name}.gz'\ntask: trunk_workers = 1, walltime = walltime, mem = mem, cores = numThreads, tags = f'{step_name}_{_output[0]:bn}'\nbash: expand= \"${ }\", stderr = f'{_output:n}.stderr', stdout = f'{_output:n}.stdout', container = container, entrypoint = entrypoint\n    Rscript ${modular_script_dir}/data_preprocessing/covariate/covariate_formatting.R \\\n        --step merge_genotype_pc \\\n        --cwd \"${cwd}\" \\\n        --pcaFile \"${pcaFile}\" \\\n        --covFile \"${covFile}\" \\\n        --name \"${name}\" \\\n        --k ${k} \\\n        --outliersFile \"${outliersFile}\" \\\n        ${\"--remove-outliers\" if remove_outliers else \"\"} \\\n        --tol-cov ${tol_cov} \\\n        ${\"--mean-impute\" if mean_impute else \"\"} \\\n        --numThreads ${numThreads}\n","key":"YJo3uh94lF"},{"type":"outputs","id":"zpDH0JlTI7UzSGdratTRe","children":[],"key":"GJdl0kJ1nd"}],"identifier":"f3684834","html_id":"f3684834","key":"LIRg81bngs"}],"key":"Qi5mDy9aou"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Covariate data preprocessing","url":"/covariate-preprocessing","group":"Data Preprocessing"},"next":{"title":"Hidden Factor Analysis","url":"/covariate-hidden-factor","group":"Data Preprocessing"}}},"domain":"http://localhost:3000"}