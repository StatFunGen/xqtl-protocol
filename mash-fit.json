mber of threads\n\nSections\n  mash_1:               Fit MASH mixture model (learns the mixture weights on\n                        the random subset)\n    Workflow Options:\n      --output-level 4 (as int)\n  mash_2:               Compute posterior for the \"strong\" set of data as in\n                        Urbut et al 2017. This is optional because most of the\n                        time we want to apply the MASH model learned on much\n                        larger data-set.\n    Workflow Options:\n      --[no-]compute-posterior (default to True)\n                        default to True; use --no-compute-posterior to disable\n                        this","position":{"start":{"line":1,"column":1},"end":{"line":50,"column":1}},"key":"qYu0iCyAAT"}],"identifier":"51ee641e","html_id":"51ee641e","key":"ohR0zljyoQ"},{"type":"block","kind":"notebook-content","data":{"kernel":"SoS"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Workflow implementation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"si5rJi3EaW"}],"identifier":"workflow-implementation","label":"Workflow implementation","html_id":"workflow-implementation","implicit":true,"key":"fbNYagtzvP"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"J68wVlQScl"},{"type":"inlineCode","value":"mash","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"trcotpt3BZ"},{"type":"text","value":" workflow has two steps. ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xWtSvFad44"},{"type":"inlineCode","value":"mash_1","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"SyBQV7fGqV"},{"type":"text","value":" fits the ","position":{"start":{"line":3,"column"