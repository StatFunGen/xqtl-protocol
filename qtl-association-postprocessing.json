script dir that holds the pecotmr_integration\n                        wrappers\n  --output-dir VAL (as path, required)\n  --sub-dir . (as path)\n  --study study\n                        labels for the assembled QtlSumStats\n  --context context\n  --genome hg38\n  --maf-cutoff 0.01 (as float)\n  --cis-window 1000000 (as int)\n  --af-col af\n  --pvalue-col pvalue\n  --molecular-id-col 'molecular_trait_object_id'\n  --pvalue-cutoff 0.05 (as float)\n                        drop pairs with p above this before assembling (keeps\n                        the object small; the per-gene min variant is always\n                        retained so the Bonferroni min is exact)\n  --fdr-threshold 0.05 (as float)\n  --regional-pattern 'cis_qtl[.]regional[.]tsv[.]gz$'\n                        list.files() regex patterns to locate the inputs in the\n                        work dir\n  --qtl-pattern 'cis_qtl[.]pairs[.]tsv[.]gz$'\n  --n-variants-suffix 'cis_n_variants_stats[.]tsv[.]gz$'\n  --[no-]enable-archive (default to False)\n\nSections\n  default:","position":{"start":{"line":1,"column":1},"end":{"line":42,"column":1}},"key":"cnSTRbNoZC"}],"identifier":"239519a1","html_id":"239519a1","key":"AUmIMSOrPc"},{"type":"block","kind":"notebook-content","data":{"kernel":"SoS"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Workflow implementation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xzhPkF4kdB"}],"identifier":"workflow-implementation","label":"Workflow implementation","html_id":"workflow-implementation","implicit":true,"key":"QhKFdnPq1U"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The cells below are the unmodified SoS workflow definition that the example above calls.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"dy7wjZemgI"}],"key":